<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de l'app (après le splash) : sans ActionBar, Compose dessine tout. -->
    <style name="Theme.Carnet.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/carnet_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Thème de lancement : l'écran de démarrage (core-splashscreen), puis bascule sur Theme.Carnet.Main. -->
    <style name="Theme.Carnet" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/carnet_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/carnet_sage</item>
        <item name="postSplashScreenTheme">@style/Theme.Carnet.Main</item>
    </style>
</resources>
